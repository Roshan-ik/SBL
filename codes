Constructor Overloading
class Complex
{
    int real, imaginary;

    Complex()
    {
        real = 0;
        imaginary = 0;
    }

    Complex(int r, int i)
    {
        real = r;
        imaginary = i;
    }

    void show()
    {
        System.out.println(real + " + " + imaginary + "i");
    }

    Complex sum(Complex A, Complex B)
    {
        Complex C = new Complex();

        C.real = A.real + B.real;
        C.imaginary = A.imaginary + B.imaginary;

        return C;
    }

    public static void main(String args[])
    {
        Complex A = new Complex(5, 3);
        Complex B = new Complex(4, 2);
        Complex C = new Complex();

        C = C.sum(A, B);

        System.out.print("First Complex Number: ");
        A.show();

        System.out.print("Second Complex Number: ");
        B.show();

        System.out.print("Addition: ");
        C.show();
    }
}


Demonstration of 2D-Array.
import java.util.Scanner;

class Matrix
{
    int a[][], b[][], sum[][], t[][];
    int r, c, i, j;

    void read()
    {
        Scanner sc = new Scanner(System.in);

        System.out.println("Enter no. of rows and columns:");
        r = sc.nextInt();
        c = sc.nextInt();

        a = new int[r][c];
        b = new int[r][c];

        System.out.println("Enter First Matrix:");

        for(i = 0; i < r; i++)
        {
            for(j = 0; j < c; j++)
            {
                a[i][j] = sc.nextInt();
            }
        }

        System.out.println("Enter Second Matrix:");

        for(i = 0; i < r; i++)
        {
            for(j = 0; j < c; j++)
            {
                b[i][j] = sc.nextInt();
            }
        }
    }

    void addition()
    {
        sum = new int[r][c];

        for(i = 0; i < r; i++)
        {
            for(j = 0; j < c; j++)
            {
                sum[i][j] = a[i][j] + b[i][j];
            }
        }
    }

    void display()
    {
        for(i = 0; i < r; i++)
        {
            for(j = 0; j < c; j++)
            {
                System.out.print(sum[i][j] + " ");
            }

            System.out.println();
        }
    }

    void transpose()
    {
        t = new int[c][r];

        for(i = 0; i < c; i++)
        {
            for(j = 0; j < r; j++)
            {
                t[i][j] = sum[j][i];
            }
        }

        for(i = 0; i < c; i++)
        {
            for(j = 0; j < r; j++)
            {
                System.out.print(t[i][j] + " ");
            }

            System.out.println();
        }
    }

    public static void main(String args[])
    {
        Matrix m = new Matrix();

        m.read();
        m.addition();

        System.out.println("Addition of matrices:");
        m.display();

        System.out.println("Transpose of addition matrix:");
        m.transpose();
    }
}

