Multilevel Inheritance
import java.util.Scanner;

class Circle
{
    float radius;

    void getRadius()
    {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter radius: ");
        radius = sc.nextFloat();
    }
}

class Area extends Circle
{
    float area;

    void calculateArea()
    {
        area = 3.14f * radius * radius;
    }
}

class Volume extends Area
{
    void calculateVolume()
    {
        float volume;

        volume = (4.0f / 3.0f) * 3.14f * radius * radius * radius;

        System.out.println("Area of Circle = " + area);
        System.out.println("Volume of Sphere = " + volume);
    }

    public static void main(String args[])
    {
        Volume v = new Volume();

        v.getRadius();
        v.calculateArea();
        v.calculateVolume();
    }
}


Demonstration of Interface
import java.util.Scanner;

class Student
{
    int roll_no;

    void getnumber()
    {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter Roll No: ");
        roll_no = sc.nextInt();
    }

    void putnumber()
    {
        System.out.println("Roll No: " + roll_no);
    }
}

class test extends Student
{
    float sem1, sem2;

    void getmarks()
    {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter Sem 1 marks: ");
        sem1 = sc.nextFloat();

        System.out.print("Enter Sem 2 marks: ");
        sem2 = sc.nextFloat();
    }

    void putmarks()
    {
        System.out.println("Sem 1 Marks: " + sem1);
        System.out.println("Sem 2 Marks: " + sem2);
    }
}

interface sports
{
    float score = 10;

    void putscore();
}

class Result extends test implements sports
{
    float total;

    void display()
    {
        total = sem1 + sem2 + score;

        putnumber();
        putmarks();
        putscore();

        System.out.println("Total Marks: " + total);
    }

    public void putscore()
    {
        System.out.println("Sports Grace Marks: " + score);
    }

    public static void main(String args[])
    {
        Result r = new Result();

        r.getnumber();
        r.getmarks();
        r.display();
    }
}


Create User-Defined Exception
class OddException extends Exception
{
    int num;

    OddException(int x)
    {
        num = x;
    }

    public String toString()
    {
        return "Number " + num + " is odd. Number must be even.";
    }
}

class MyExceptionDemo
{
    static void OddNoException(int x) throws OddException
    {
        if(x % 2 != 0)
        {
            throw new OddException(x);
        }
        else
        {
            System.out.println("Square = " + (x * x));
        }
    }

    public static void main(String args[])
    {
        try
        {
            OddNoException(3);
        }
        catch(OddException e)
        {
            System.out.println(e);
        }
    }
}


Demonstration of Multithreading
class Thread1 implements Runnable
{
    public void run()
    {
        for(int i = 1; i <= 10; i++)
        {
            System.out.println("Number: " + i);
        }
    }
}

class Thread2 implements Runnable
{
    public void run()
    {
        for(int i = 1; i <= 10; i++)
        {
            System.out.println("Square: " + (i * i));
        }
    }
}

class multithread
{
    public static void main(String args[])
    {
        Thread1 obj1 = new Thread1();
        Thread2 obj2 = new Thread2();

        Thread t1 = new Thread(obj1);
        Thread t2 = new Thread(obj2);

        t1.start();
        t2.start();
    }
}
