Demonstration of Looping Statement.
class Prime
{
    public static void main(String args[])
    {
        int i, j, num = 1000, flag;

        for(i = 1; i <= num; i++)
        {
            flag = 1;

            for(j = 2; j < i; j++)
            {
                if(i % j == 0)
                {
                    flag = 0;
                    break;
                }
            }

            if(flag == 1)
            {
                System.out.println(i);
            }
        }
    }
}

